From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Sun, 19 Apr 2026 18:05:00 +0200
Subject: [PATCH] arm: dts: rockpro64: disable fe900000 USB3 host for control build

This is a ROCKPro64 USB probe investigation helper patch.

Disable the second RK3399 USB3 host path on RockPro64 by marking both the
wrapper node and the DWC3 child node disabled in the board dtsi. This is a
test-only control used to separate controller-specific failures at `usb@fe900000`
from generic USB boot flow issues.
---
 arch/arm/dts/rk3399-rockpro64.dtsi | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/arch/arm/dts/rk3399-rockpro64.dtsi b/arch/arm/dts/rk3399-rockpro64.dtsi
--- a/arch/arm/dts/rk3399-rockpro64.dtsi
+++ b/arch/arm/dts/rk3399-rockpro64.dtsi
@@ -845,10 +845,10 @@
 };
 
 &usbdrd3_1 {
-	status = "okay";
+	status = "disabled";
 };
 
 &usbdrd_dwc3_1 {
-	status = "okay";
-	dr_mode = "host";
+	status = "disabled";
+	dr_mode = "host";
 };
